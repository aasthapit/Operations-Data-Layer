{
  // ADR-0005. `allowJs` is what let .js/.jsx and .ts/.tsx coexist while the
  // conversion was in flight: converted modules were checked, the rest were
  // still resolved (so an import from a .tsx into a .jsx module was a real edge
  // in the graph) but not checked themselves - `checkJs: false`. Phase 2
  // finished the conversion, so nothing under `src` is .js any more; the pair
  // stays because the setting that would actually bite - `checkJs` - is off,
  // and dropping `allowJs` belongs with the rest of the Phase 3 config sweep.
  //
  // `strict` is on as of Phase 2c: Phases 1 and 2 converted with it off so that
  // the move to TypeScript was a mechanical, reviewable change rather than a
  // conversion plus a thousand null checks at once. The explicit
  // `noImplicitAny: false` that went with it is gone - `strict` implies it.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // The browser APIs the app is written against (fetch, history, AbortController).
    // Not implied by `target`, so it has to be named.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",

    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "skipLibCheck": true,

    // Vite transpiles file by file, so anything that needs whole-program
    // knowledge to emit (const enums, re-exported types without `export type`)
    // has to be an error here rather than a runtime surprise.
    "isolatedModules": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,

    // `vite/client` types import.meta.env; `vitest/globals` types the describe /
    // it / expect the suite uses without importing them; `node` is there for the
    // one test that shells out - src/api/schema.test.ts regenerates schema.ts
    // into a temp directory and diffs it, which needs node:child_process and
    // node:fs.
    "types": ["vite/client", "vitest/globals", "node"]
  },
  "include": ["src", "vite.config.ts"]
}
