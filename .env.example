# Copied to .env by `make dev-venv`. Read by docker compose AND by honcho, so
# the container stack and the ad-hoc host processes agree on every port.
#
# Container stack (docker compose): host ports. Defaults avoid the ports the
# main stack uses, so a worktree can run beside it.
ODL_API_PORT=18001
ODL_DASHBOARD_PORT=8081
ODL_PATCHING_PORT=18011
ODL_MCP_PORT=18081
ODL_N8N_PORT=5679
ODL_REDIS_PORT=16379

# Ad-hoc host processes (honcho): the hot-reloading read-only API, the Vite
# dev server, the MCP server.
DEV_API_PORT=18002
DEV_UI_PORT=5174
DEV_MCP_PORT=18082

# ---- Redis --------------------------------------------------------------
# Where the fleet state lives. Leave unset to use the local Redis on
# ODL_REDIS_PORT (the compose container, or redis-server from Procfile.local).
# Any redis-py URL works: redis://host:6379/0, redis://:password@host:6379/0,
# redis://user:password@host:6379/0, rediss://user:password@host:6380/0 (TLS).
# REDIS_URL=rediss://odl:change-me@redis.example.internal:6380/0
# Key prefix, in case the instance is shared, and how long a cluster that is
# never collected again stays visible (seconds, 0 = forever).
# REDIS_PREFIX=odl
# REDIS_TTL_SECONDS=86400

# ---- Clusters (no-Docker mode, `make local`) ------------------------------
# The fleet config: `clusters:` (a direct list of live OCP API endpoints, see
# data-layer/config/clusters.example.yaml) or `hubs:` (ACM hubs with
# kubeconfigs). Relative to data-layer/. clusters.yaml is git-ignored.
# ODL_CONFIG=config/clusters.yaml
# Credentials the config references as ${VAR}:
# OCP_PASSWORD=
# Set false to run a read-only API against a Redis another instance fills.
# COLLECTOR_ENABLED=true
# REFRESH_INTERVAL_SECONDS=120
# COLLECT_WORKERS=4

# Only needed for POST /api/query/ask (natural-language questions). Everything
# else, including POST /api/query/sql, works without it.
# ANTHROPIC_API_KEY=
