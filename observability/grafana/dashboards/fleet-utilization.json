{
  "uid": "odl-fleet-util",
  "title": "Fleet Utilization",
  "tags": ["odl"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Top namespaces by CPU (cores)",
      "datasource": { "type": "prometheus", "uid": "thanos" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "thanos" },
          "expr": "topk(8, sum by (namespace, cluster) (odl_namespace_cpu_usage_cores))",
          "legendFormat": "{{namespace}} @ {{cluster}}" }
      ]
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Top namespaces by memory (bytes)",
      "datasource": { "type": "prometheus", "uid": "thanos" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "thanos" },
          "expr": "topk(8, sum by (namespace, cluster) (odl_namespace_memory_usage_bytes))",
          "legendFormat": "{{namespace}} @ {{cluster}}", "instant": true }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Node CPU utilization % (top 8)",
      "datasource": { "type": "prometheus", "uid": "thanos" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "thanos" },
          "expr": "topk(8, 100 * odl_node_cpu_usage_cores / odl_node_cpu_allocatable_cores)",
          "legendFormat": "{{node}} @ {{cluster}}" }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "CPU headroom by cluster (allocatable - used, cores)",
      "datasource": { "type": "prometheus", "uid": "thanos" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "showHeader": true },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "thanos" },
          "expr": "sum by (cluster) (odl_node_cpu_allocatable_cores) - sum by (cluster) (odl_node_cpu_usage_cores)",
          "legendFormat": "{{cluster}}", "instant": true, "format": "table" }
      ]
    }
  ]
}
